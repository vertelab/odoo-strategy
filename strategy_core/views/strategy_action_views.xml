<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_strategy_action_tree" model="ir.ui.view">
        <field name="name">strategy.action.tree</field>
        <field name="model">strategy.action</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="action_type"/><field name="state" widget="badge"/><field name="effect_amount" widget="monetary"/><field name="risk_id"/><field name="initiative_id"/></list>
        </field>
    </record>
    <record id="view_strategy_action_form" model="ir.ui.view">
        <field name="name">strategy.action.form</field>
        <field name="model">strategy.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'proposed'" class="btn-primary"/>
                    <button name="action_start" type="object" string="Start" invisible="state != 'approved'" class="btn-success"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'" class="btn-success"/>
                    <button name="action_dismiss" type="object" string="Dismiss" invisible="state not in ('proposed','approved','in_progress')" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group><field name="name"/><field name="plan_id"/><field name="action_type"/><field name="risk_id"/><field name="initiative_id"/></group>
                    <group string="Impact"><field name="effect_amount" widget="monetary"/><field name="effect_description"/></group>
                    <group string="Description"><field name="description" widget="html"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_strategy_action" model="ir.actions.act_window">
        <field name="name">Strategic Actions</field>
        <field name="res_model">strategy.action</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
