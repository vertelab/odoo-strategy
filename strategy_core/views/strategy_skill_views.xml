<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_strategy_skill_tree" model="ir.ui.view">
        <field name="name">strategy.skill.tree</field>
        <field name="model">strategy.skill</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="category"/><field name="version"/><field name="is_base"/><field name="is_active"/></list>
        </field>
    </record>
    <record id="view_strategy_skill_form" model="ir.ui.view">
        <field name="name">strategy.skill.form</field>
        <field name="model">strategy.skill</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group><field name="name"/><field name="category"/><field name="version"/></group>
                <group><field name="is_base"/><field name="is_active"/></group>
                <group string="Content"><field name="description"/><field name="skill_content" /></group>
            </sheet><chatter/></form>
        </field>
    </record>
    <record id="view_strategy_skill_search" model="ir.ui.view">
        <field name="name">strategy.skill.search</field>
        <field name="model">strategy.skill</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/><field name="category"/>
                <filter name="base" string="Base" domain="[('is_base','=',True)]"/>
                <filter name="active" string="Active" domain="[('is_active','=',True)]"/>
                <separator/><filter name="gcat" string="Category" context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>
    <record id="action_strategy_skill" model="ir.actions.act_window">
        <field name="name">Strategy Skills</field>
        <field name="res_model">strategy.skill</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
