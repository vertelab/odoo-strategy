<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════
        STRATEGY MEETING — TREE VIEW
        ═══════════════════════════════════════════════════════════════ -->

        <record id="view_strategy_meeting_tree" model="ir.ui.view">
            <field name="name">strategy.meeting.tree</field>
            <field name="model">strategy.meeting</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="meeting_type" widget="badge" decoration-success="meeting_type == 'management'" decoration-info="meeting_type == 'board'"/>
                    <field name="date"/>
                    <field name="state" widget="badge"
                           decoration-success="state == 'completed'"
                           decoration-warning="state == 'in_progress'"
                           decoration-muted="state == 'cancelled'"/>
                    <field name="plan_id" optional="show"/>
                    <field name="participant_count"/>
                    <field name="user_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
        STRATEGY MEETING — FORM VIEW
        ═══════════════════════════════════════════════════════════════ -->

        <record id="view_strategy_meeting_form" model="ir.ui.view">
            <field name="name">strategy.meeting.form</field>
            <field name="model">strategy.meeting</field>
            <field name="arch" type="xml">
                <form string="Strategic Meeting">
                    <header>
                        <button name="action_start" string="Start Meeting" type="object"
                                class="btn-primary"
                                invisible="state not in ('scheduled',)"/>
                        <button name="action_complete" string="Complete Meeting" type="object"
                                class="btn-success"
                                invisible="state not in ('in_progress',)"/>
                        <button name="action_cancel" string="Cancel Meeting" type="object"
                                class="btn-danger"
                                invisible="state in ('completed', 'cancelled')"/>
                        <button name="action_draft" string="Reset to Scheduled" type="object"
                                invisible="state not in ('cancelled', 'completed')"/>
                        <field name="state" widget="statusbar" statusbar_visible="scheduled,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Meeting"/>
                            <h1>
                                <field name="name" placeholder="e.g. Q3 Board Meeting"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="meeting_type"/>
                                <field name="plan_id"/>
                                <field name="user_id"/>
                            </group>
                            <group>
                                <field name="calendar_event_id" options="{'no_create': True, 'no_open': True}"/>
                                <field name="date"/>
                                <field name="template_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_create_calendar_event" type="object"
                                    class="oe_stat_button" icon="fa-calendar">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Calendar</span>
                                </div>
                            </button>
                            <button name="action_auto_compose_participants" type="object"
                                    class="oe_stat_button" icon="fa-users">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Compose Participants</span>
                                </div>
                            </button>
                            <button name="action_apply_template" type="object"
                                    class="oe_stat_button" icon="fa-file-text-o">
                                <div class="o_stat_info">
                                    <span class="o_stat_text">Apply Template</span>
                                </div>
                            </button>
                        </div>
                        <notebook>
                            <page name="agenda" string="Agenda">
                                <field name="agenda_item_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="item_type" widget="badge" optional="show"/>
                                        <field name="department_id" optional="show"/>
                                        <field name="duration_minutes"/>
                                        <field name="user_id"/>
                                        <field name="report_status" widget="badge" optional="show"/>
                                        <field name="state" widget="badge"/>
                                        <field name="source"/>
                                    </list>
                                </field>
                            </page>
                            <page name="participants" string="Participants">
                                <field name="participant_ids">
                                    <list editable="bottom">
                                        <field name="employee_id"/>
                                        <field name="role" widget="badge"/>
                                        <field name="attended"/>
                                        <field name="rsvp_status"/>
                                    </list>
                                </field>
                            </page>
                            <page name="decisions" string="Decisions">
                                <field name="decision_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="state" widget="badge"/>
                                        <field name="agenda_item_id"/>
                                        <field name="ref_display_name"/>
                                        <field name="user_id"/>
                                    </list>
                                </field>
                            </page>
                            <page name="minutes" string="Minutes">
                                <field name="minutes_draft" placeholder="AI-generated draft minutes..."/>
                                <field name="minutes_html" placeholder="Final minutes..."/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
        STRATEGY MEETING — KANBAN VIEW
        ═══════════════════════════════════════════════════════════════ -->

        <record id="view_strategy_meeting_kanban" model="ir.ui.view">
            <field name="name">strategy.meeting.kanban</field>
            <field name="model">strategy.meeting</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="meeting_type"/>
                    <field name="state"/>
                    <field name="date"/>
                    <field name="participant_count"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('strategy.meeting', 'id', record.id.raw_value)"
                                         t-att-alt="record.name.value" style="display:none;"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="meeting_type" widget="badge"
                                               decoration-success="meeting_type == 'management'"
                                               decoration-info="meeting_type == 'board'"/>
                                        <field name="state" widget="badge"/>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="date"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <i class="fa fa-users"/> <field name="participant_count"/> participants
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
        STRATEGY MEETING — SEARCH VIEW
        ═══════════════════════════════════════════════════════════════ -->

        <record id="view_strategy_meeting_search" model="ir.ui.view">
            <field name="name">strategy.meeting.search</field>
            <field name="model">strategy.meeting</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="meeting_type"/>
                    <field name="state"/>
                    <filter name="filter_upcoming" string="Upcoming"
                            domain="[('state', '=', 'scheduled')]"/>
                    <filter name="filter_board" string="Board"
                            domain="[('meeting_type', '=', 'board')]"/>
                    <filter name="filter_management" string="Management"
                            domain="[('meeting_type', '=', 'management')]"/>
                    <separator/>
                    <filter name="filter_my" string="My Meetings"
                            domain="[('user_id', '=', uid)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_type" string="Type"
                                context="{'group_by': 'meeting_type'}"/>
                        <filter name="group_state" string="Status"
                                context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════
        STRATEGY MEETING — ACTION
        ═══════════════════════════════════════════════════════════════ -->

        <record id="action_strategy_meeting" model="ir.actions.act_window">
            <field name="name">Meetings</field>
            <field name="res_model">strategy.meeting</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="search_view_id" ref="view_strategy_meeting_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Schedule your first strategic meeting.
                </p>
                <p>
                    Create board meetings and management team meetings with
                    structured agendas, participants, decisions, and minutes.
                </p>
            </field>
        </record>

    </data>
</odoo>
