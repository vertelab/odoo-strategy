<odoo>
    <record id="view_strategy_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.strategy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Strategy" string="Strategy"
                     name="strategy" data-icon="fa-bullseye">

                    <block title="Background Jobs">
                        <setting id="strategy_bg_jobs_display" string="Cron-jobb">
                            <field name="strategy_cron_line_ids" widget="one2many">
                                <form>
                                    <group>
                                        <field name="cron_id" readonly="1" force_save="1"/>
                                        <field name="cron_name" readonly="1"/>
                                        <field name="cron_active"/>
                                        <field name="cron_interval_number"/>
                                        <field name="cron_interval_type"/>
                                        <field name="cron_lastcall" readonly="1"/>
                                        <field name="cron_failure_count" readonly="1"/>
                                        <field name="cron_code" readonly="1"/>
                                        <button name="action_run_now" type="object"
                                                string="Kör nu" icon="fa-play"/>
                                    </group>
                                </form>
                                <list>
                                    <field name="cron_name"/>
                                    <field name="cron_active"/>
                                    <field name="cron_interval_number"/>
                                    <field name="cron_interval_type"/>
                                    <field name="cron_lastcall"/>
                                    <field name="cron_failure_count"/>
                                </list>
                            </field>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Settings action + meny -->
    <record id="action_strategy_settings" model="ir.actions.act_window">
        <field name="name">Strategy Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'strategy_core', 'bin_size': False}</field>
    </record>

    <menuitem id="menu_strategy_settings"
              name="Settings"
              parent="strategy_core.menu_strategy_root"
              sequence="99"
              action="action_strategy_settings"/>
</odoo>
