<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Security groups for strategy modules -->
    <record id="group_strategy_manager" model="res.groups">
        <field name="name">Strategy Manager</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_strategy_pi_agent" model="res.groups">
        <field name="name">Strategy Pi Agent</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_strategy_user" model="res.groups">
        <field name="name">Strategy User</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
