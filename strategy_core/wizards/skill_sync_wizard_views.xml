<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_skill_sync_wizard" model="ir.ui.view">
        <field name="name">strategy.skill.sync.wizard</field>
        <field name="model">strategy.skill.sync</field>
        <field name="arch" type="xml">
            <form string="Sync Skills">
                <sheet>
                    <h3>Sync Strategy Skills</h3>
                    <group>
                        <field name="direction" widget="radio" options="{'horizontal': True}"/>
                        <field name="format" widget="radio" options="{'horizontal': True}"/>
                    </group>
                    <group><field name="skill_dir"/></group>
                    <group invisible="direction == 'import'">
                        <field name="skill_ids" widget="many2many" options="{'no_quick_create':True}"/>
                    </group>
                    <footer>
                        <button name="action_sync" type="object" string="Sync" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
