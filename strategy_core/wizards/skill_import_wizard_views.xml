<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_skill_import_wizard" model="ir.ui.view">
        <field name="name">strategy.skill.import.wizard</field>
        <field name="model">strategy.skill.import</field>
        <field name="arch" type="xml">
            <form string="Import Strategy Skills">
                <sheet>
                    <div class="oe_title">
                        <h3>Import Strategy Skills from SKILL.md files</h3>
                    </div>
                    <p class="text-muted">
                        This will scan the <code>skills/</code> directory and import all
                        SKILL.md files into <code>marketing.skill</code> records.
                        Existing skills with the same name will be updated.
                    </p>
                    <footer>
                        <button name="action_import" type="object" string="Import Skills" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_skill_import" model="ir.actions.act_window">
        <field name="name">Import Strategy Skills</field>
        <field name="res_model">strategy.skill.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
