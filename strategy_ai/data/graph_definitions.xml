<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- strategy.plan → :StrategyPlan -->
        <record id="graph_node_strategy_plan" model="graph.node.definition">
            <field name="model_id" ref="strategy_core.model_strategy_plan"/>
            <field name="graph_label">StrategyPlan</field>
            <field name="name_field">name</field>
            <field name="active">True</field>
        </record>

        <!-- okr.objective → :OKR -->
        <record id="graph_node_okr" model="graph.node.definition">
            <field name="model_id" ref="strategy_core.model_okr_objective"/>
            <field name="graph_label">OKR</field>
            <field name="name_field">title</field>
            <field name="active">True</field>
        </record>

        <!-- strategy.risk → :Risk -->
        <record id="graph_node_risk" model="graph.node.definition">
            <field name="model_id" ref="strategy_core.model_strategy_risk"/>
            <field name="graph_label">Risk</field>
            <field name="name_field">name</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
